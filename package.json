{
    "name": "cart-my-recipe",
    "displayName": "Cart My Recipe",
    "version": "1.0.3",
    "description": "Turn any recipe into a grocery delivery!",
    "author": "Giridhar Nair",
    "license": "MIT",
    "type": "module",
    "private": true,
    "scripts": {
        "install-api-dependencies": "pip install -r api/requirements-dev.txt",
        "format-api": "ruff format api",
        "lint-api": "ruff check api",
        "api": "fastapi dev api/main.py",
        "format": "prettier --write . --tab-width 4",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "build:css": "tailwindcss -i src/tailwind.css -o src/style.gen.css --minify",
        "dev:css": "tailwindcss -i src/tailwind.css -o src/style.gen.css --watch",
        "dev": "npm run build:css && concurrently -k -n css,plasmo \"npm:dev:css\" \"plasmo dev\"",
        "build": "npm run build:css && plasmo build",
        "package": "plasmo package"
    },
    "dependencies": {
        "@plasmohq/messaging": "^0.7.1",
        "@radix-ui/react-scroll-area": "^1.2.10",
        "@radix-ui/react-separator": "^1.1.7",
        "@radix-ui/react-slot": "^1.2.3",
        "axios": "^1.11.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^0.539.0",
        "plasmo": "^0.90.5",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "svgo": "^3.3.4",
        "tailwind-merge": "^3.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.18.0",
        "@tailwindcss/cli": "^4.1.11",
        "@types/chrome": "^0.1.43",
        "@types/node": "^24.2.1",
        "@types/react": "^18.3.23",
        "@types/react-dom": "^18.3.7",
        "concurrently": "^9.1.2",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-react-hooks": "^5.1.0",
        "globals": "^15.14.0",
        "prettier": "^3.6.2",
        "tailwindcss": "^4.1.11",
        "tw-animate-css": "^1.3.6",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.20.0"
    },
    "manifest": {
        "key": "",
        "permissions": [
            "sidePanel",
            "activeTab",
            "scripting",
            "storage"
        ]
    }
}
