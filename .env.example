# ---- Extension (Plasmo) ----
# Only PLASMO_PUBLIC_* vars are exposed to the extension bundle.
PLASMO_PUBLIC_BACKEND_API_URL=http://localhost:8000

# ---- Backend (FastAPI) ----
OPENAI_API_KEY=
# Model used to convert raw recipe ingredients into Instacart line items.
OPENAI_MODEL=gpt-4o-2024-08-06

# Instacart Developer Platform.
# Dev keys (prefix "keys.") use the dev server; prod keys use https://connect.instacart.com
INSTACART_SERVER=https://connect.dev.instacart.tools
INSTACART_API_KEY=
# Optional affiliate/UTM suffix appended to the generated products link.
INSTACART_PARTNER_URL=

# ---- Backend security / limits (all optional; sensible defaults) ----
# Rate limiting is handled at the edge by Vercel Firewall rules, not in code.
# Comma-separated browser origin allowlist, or "*" for any.
ALLOWED_ORIGINS=*
# Outbound Instacart request timeout in seconds.
INSTACART_TIMEOUT=15
